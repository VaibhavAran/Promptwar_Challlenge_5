# Gatherly AI — Environment Variables
# Copy this file to .env.local for local development, or configure in Vercel Project Settings.

# Google Gemini API Key (Required for server-side generation)
# Obtain a key from Google AI Studio: https://aistudio.google.com/
# NEVER prefix with VITE_ to prevent client-side bundle exposure.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override the Gemini model without changing application code.
# The default is a currently supported Flash model.
GEMINI_MODEL=gemini-3.5-flash-lite

